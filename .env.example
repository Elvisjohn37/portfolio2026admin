# Base URL of the Express API (portfolio2026backend). Required.
# Local development: http://localhost:8080
# Production: https://portfolio2026backend.vercel.app
API_URL=http://localhost:8080

# URL of the public portfolio, used by the "View site" link in the sidebar.
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000

# Lifetime of the httpOnly session cookie, in seconds.
# Keep it in sync with JWT_EXPIRES_IN on the API (1d = 86400).
SESSION_MAX_AGE_SECONDS=86400
